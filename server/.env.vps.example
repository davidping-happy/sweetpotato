# ===== VPS 部署範例（複製為 server/.env 後修改）=====
# cp server/.env.vps.example server/.env

PORT=3000

# VPS 不使用 MongoDB 時請留空或刪除此行（訂單存於 server/data/orders.json）
# MONGODB_URI=

# 訂單資料目錄（Docker 內路徑，一般不需改）
ORDER_DATA_DIR=/app/server/data

# ===== 後台登入 =====
ADMIN_EMAIL=你的後台信箱@example.com
ADMIN_PASSWORD=請改成強密碼
ADMIN_JWT_SECRET=請改成至少32字元的隨機字串

# 您的 VPS 對外網址（有 HTTPS 網域時改為 https://api.您的網域）
ADMIN_APP_URL=http://您的VPS_IP:3000
PUBLIC_API_BASE_URL=http://您的VPS_IP:3000

# ===== SMTP（選填，寄訂單確認信）=====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sweetpotatograndmom@gmail.com
SMTP_PASS=Gmail應用程式密碼
SMTP_FROM=磐石烤地瓜 <sweetpotatograndmom@gmail.com>
SHOP_NOTIFY_EMAIL=sweetpotatograndmom@gmail.com

# ===== LINE（選填）=====
LINE_CHANNEL_ACCESS_TOKEN=
LINE_SHOP_USER_ID=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=http://您的VPS_IP:3000/api/line/login/callback
LINE_STOREFRONT_URL=https://davidping-happy.github.io/sweetpotato/docs/index.html

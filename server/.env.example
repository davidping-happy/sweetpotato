# ===== 伺服器 =====
PORT=3000

# ===== MongoDB =====
# 本機: mongodb://localhost:27017/panshi
# Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/panshi
MONGODB_URI=mongodb://localhost:27017/panshi

# ===== Admin Auth (Render 後台登入) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_please
ADMIN_JWT_SECRET=change_this_to_a_long_random_secret

# ===== SMTP 郵件 (可選) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="磐石烤地瓜 <your_email@gmail.com>"

# ===== LINE Webhook (可選) =====
LINE_NOTIFY_WEBHOOK_URL=

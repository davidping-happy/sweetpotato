# ===== 伺服器 =====
PORT=3000

# ===== MongoDB（選填；VPS 可不設，改存 server/data/orders.json）=====
# 本機: mongodb://localhost:27017/panshi
# Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/panshi
# VPS 不用 MongoDB 時請刪除或留空 MONGODB_URI
# MONGODB_URI=mongodb://localhost:27017/panshi

# VPS Docker 訂單目錄（本機開發可省略）
# ORDER_DATA_DIR=/app/server/data

# ===== Admin Auth (Render 後台登入) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_please
ADMIN_JWT_SECRET=change_this_to_a_long_random_secret
# 密碼重設信內連結的網站根網址（需含後台登入頁所在網域）
# 例：https://sweetpotato-api.onrender.com
ADMIN_APP_URL=http://localhost:3000
# 前台/後台呼叫的公開 API 根網址（供 /api/config 與 app-config.json 使用）
PUBLIC_API_BASE_URL=http://localhost:3000

# ===== SMTP 郵件 (可選) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="磐石烤地瓜 <your_email@gmail.com>"

# ===== 店家通知 Email（電子報新訂閱通知） =====
SHOP_NOTIFY_EMAIL=sweetpotatograndmom@gmail.com

# ===== LINE Messaging API（官方帳號：推播、webhook 商品卡片、圖文選單） =====
# Channel access token（long-lived）與店家 LINE userId
LINE_CHANNEL_ACCESS_TOKEN=
LINE_SHOP_USER_ID=
# Messaging API 頻道的 Channel secret（webhook 簽章驗證用，建議填寫）
LINE_CHANNEL_SECRET=
# 客戶綁定 LINE（LINE Login channel，非 Messaging API）
# Developers → 建立「LINE Login」類型 Channel → 複製 Channel ID / Channel secret
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# LINE Login Callback URL 請設為：https://sweetpotato-api.onrender.com/api/line/login/callback
LINE_STOREFRONT_URL=https://davidping-happy.github.io/sweetpotato/docs/index.html
# LIFF ID：在 LINE Login 頻道新增 LIFF，Endpoint URL 設為上方 LINE_STOREFRONT_URL，
# 使用者即可在 LINE 內建瀏覽器直接逛商店並自動連動身分。
LINE_LIFF_ID=
# 促銷大圖（魚中魚版型）圖片網址（公開 HTTPS）；留空則用 CDN 的 photo/promo-banner.jpg
LINE_PROMO_IMAGE_URL=
# 舊版 Make webhook（僅備援，無法確認是否真正送達 LINE）
LINE_NOTIFY_WEBHOOK_URL=
# Webhook URL（填到 LINE Developers → Messaging API → Webhook URL）：
#   https://<你的後端網域>/api/line/webhook   例：https://sweetpotato-api.onrender.com/api/line/webhook

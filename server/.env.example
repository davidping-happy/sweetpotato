# ===== 伺服器 =====
PORT=3000

# ===== MongoDB =====
# 本機: mongodb://localhost:27017/panshi
# Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/panshi
MONGODB_URI=mongodb://localhost:27017/panshi

# ===== Admin Auth (Render 後台登入) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_please
ADMIN_JWT_SECRET=change_this_to_a_long_random_secret
# 密碼重設信內連結的網站根網址（需含後台登入頁所在網域）
# 例：https://sweetpotato-api.onrender.com
ADMIN_APP_URL=http://localhost:3000

# ===== SMTP 郵件 (可選) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="磐石烤地瓜 <your_email@gmail.com>"

# ===== LINE Messaging API（建議，可推播到店家與客戶） =====
# Channel access token（long-lived）與店家 LINE userId
LINE_CHANNEL_ACCESS_TOKEN=
LINE_SHOP_USER_ID=
# 客戶綁定 LINE 用（LINE Developers → LIFF → Add → 複製 LIFF ID）
# 格式必須含連字號，例如 1234567890-AbCdEfGh（不可只填 Channel ID 純數字）
# LIFF Endpoint URL 請設為前台網址，例如 https://davidping-happy.github.io/sweetpotato/docs/index.html
LINE_LIFF_ID=
# 舊版 Make webhook（僅備援，無法確認是否真正送達 LINE）
LINE_NOTIFY_WEBHOOK_URL=
